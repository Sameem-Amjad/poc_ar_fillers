# ── EC2 .env template ─────────────────────────────────────────────────────────
# Copy to .env and fill in your values. Never commit .env to git.

# Your nip.io domain — replace dots with dashes in your EC2 IP
# e.g. EC2 IP 54.123.45.67  →  APP_DOMAIN=54-123-45-67.nip.io
APP_DOMAIN=YOUR_EC2_IP_DASHES.nip.io

# Docker images — CI updates these automatically on each deploy
FRONTEND_IMAGE=ghcr.io/YOUR_GITHUB_USERNAME/poc_ar_filter/frontend:latest
BACKEND_IMAGE=ghcr.io/YOUR_GITHUB_USERNAME/poc_ar_filter/backend:latest

# Database — SQLite by default (no setup needed), or use Supabase PostgreSQL
DATABASE_URL=sqlite:////app/data/poc_ar_filter.db
# DATABASE_URL=postgresql://postgres:PASSWORD@db.XXXX.supabase.co:5432/postgres

# Supabase (optional — for image storage)
SUPABASE_URL=
SUPABASE_KEY=

CORS_ORIGINS=*
